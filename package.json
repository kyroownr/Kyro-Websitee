{
  "name": "kyro-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kyro editing-assets website, Cloudflare Worker, and multi-server utility bot dashboard.",
  "scripts": {
    "start": "node bot_dashboard.js",
    "dashboard": "node bot_dashboard.js",
    "deploy": "npx wrangler deploy --minify",
    "build:hardened": "node tools/build-hardened.cjs",
    "build:site": "node tools/build-site.cjs",
    "test": "node tools/requests.test.cjs && node tools/security.test.cjs && node tools/community.test.cjs && node tools/upload.test.cjs && node tools/dashboard.test.cjs && node tools/publish.test.cjs",
    "test:requests": "node tools/requests.test.cjs",
    "test:security": "node tools/security.test.cjs",
    "test:community": "node tools/community.test.cjs",
    "test:dashboard": "node tools/dashboard.test.cjs",
    "test:applications": "node tools/applications.test.cjs",
    "test:upload": "node tools/upload.test.cjs",
    "test:publish": "node tools/publish.test.cjs",
    "test:ui": "node tools/ui.test.cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261113.0-beta",
    "wrangler": "^4.162.0"
