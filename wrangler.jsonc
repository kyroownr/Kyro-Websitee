{
  // Cloudflare Worker backing the Discord OAuth2 flow for kyro.new.tg.
  // DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET live on the dashboard as
  // secret_text bindings, so `wrangler deploy` never touches or overwrites them.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kyro-auth",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,

  // Was already enabled on the dashboard; declaring it keeps `wrangler deploy`
  // from switching Worker Logs off with its local default.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },

  // Plaintext. Without KYRO_GUILD_ID readSession() can never report a member,
  // so verification would silently fail for everyone.
  "vars": {
    "KYRO_GUILD_ID": "1539961184323772498"
  },

  "kv_namespaces": [
    { "binding": "KYRO_DATA", "id": "d8cdcab9b50242128f73675a3b242b01" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "KYRO_REQUESTS", "class_name": "KyroRequests" },
      { "name": "KYRO_APPLICATIONS", "class_name": "KyroApplications" }
    ]
  },
  "migrations": [
    { "tag": "requests-v1", "new_sqlite_classes": ["KyroRequests"] },
    { "tag": "applications-v1", "new_sqlite_classes": ["KyroApplications"] }
  ]
}
