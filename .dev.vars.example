# Copy to .dev.vars for `wrangler dev`, then fill in the real values.
# On the deployed worker set the same names under Settings → Variables, or with
#   wrangler secret put DISCORD_CLIENT_SECRET
DISCORD_CLIENT_ID=1570702041993711706
DISCORD_CLIENT_SECRET=replace-with-the-discord-app-client-secret
KYRO_GUILD_ID=1539961184323772498
KYRO_SITE_URL=https://kyro.new.tg
KYRO_ALLOWED_ORIGINS=https://kyro.new.tg

# Production application secrets: run tools/open-applications.ps1.
# Never put production tokens in this file or .dev.vars.
# DISCORD_BOT_TOKEN and DISCORD_APPLICATION_PUBLIC_KEY use encrypted Worker secrets.
# Non-secret Discord IDs are configured in wrangler.jsonc.
# Interactions endpoint: https://kyro-auth.kyro-ownr.workers.dev/api/discord/interactions

# Optional: set to "false" to close applications again without a redeploy.
# KYRO_APPLICATIONS_OPEN=false
# Optional: let an applicant see their own private review channel.
# KYRO_APPLICATION_INTERVIEW_ENABLED=true
