# Secrets — the Discord client secret lives only in the Worker's environment.
.env
.env.*
.dev.vars
.dev.vars.*
.wrangler/

# Templates that document the names above stay in the repo.
!.env.example
!.dev.vars.example

# Hardened worker build — regenerate with `npm run build:hardened`
dist/

# docs/ is the published site mirror and is committed on purpose.
_site/

# Download links and archive passwords — upload to KV, never commit
vault-links.json

# Local tooling and OS noise
node_modules/
*.log
.DS_Store
Thumbs.db
worker-configuration.d.ts

# Local dashboard state (per-guild config, giveaways, warnings) — never committed
dashboard_data.json
published_uploads.json
